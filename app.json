{
  "expo": {
    "name": "EduAttend",
    "slug": "eduattend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9e7a"
      },
      "package": "com.eduattend.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#085041"
        }
      ],
      "expo-font"
    ],
    "scheme": "eduattend",
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "df576eaf-8b6f-4f67-bee1-ec9de91fe7f4"
      }
    },
    "owner": "newtech313"
  }
}
